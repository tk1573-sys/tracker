APP_NAME=MyManager AI API
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO

DATABASE_URL=sqlite:///./tracker.db
# DATABASE_URL=postgresql+psycopg://<db_user>:<db_password>@db:5432/<db_name>

POSTGRES_DB=tracker
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

JWT_SECRET_KEY=REPLACE_WITH_SECURE_RANDOM_STRING
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

REMINDER_WORKER_ENABLED=true
REMINDER_WORKER_INTERVAL_SECONDS=60
REMINDER_WORKER_RETRY_ATTEMPTS=3
REMINDER_WORKER_RETRY_BACKOFF_SECONDS=0.25
